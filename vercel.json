{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/acesso/?",
      "destination": "/acesso/index.html"
    },
    {
      "source": "/entrar/?",
      "destination": "/entrar/index.html"
    },
    {
      "source": "/ativar/?",
      "destination": "/ativar/index.html"
    },
    {
      "source": "/orbiex/acesso/?",
      "destination": "/acesso/index.html"
    },
    {
      "source": "/orbiex/entrar/?",
      "destination": "/entrar/index.html"
    },
    {
      "source": "/orbiex/ativar/?",
      "destination": "/ativar/index.html"
    }
  ]
}